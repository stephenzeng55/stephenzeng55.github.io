---
import favicon from "../assets/zeng.webp";

type Props = {
  lang?: string;
  title?: string;
  description?: string;
};

const {
  lang = "en",
  title = "Stephen Zeng | Portfolio",
  description = "Stephen Zeng is a Washington, D.C.-based Senior .NET Software Developer with experience in C#, Vue.js, TypeScript, AWS, and Microsoft Azure.",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/webp" href={favicon.src} />
    {
      lang === "yue-Hant" && (
        <link
          rel="stylesheet"
          href="https://cdn.jsdelivr.net/gh/ichitenfont/I.MingWebfont/index.css"
        />
      )
    }
    {
      lang === "ja" && (
        <style is:inline>
          @import
          url('https://fonts.googleapis.com/css2?family=Kaisei+Tokumin:wght@400;500;700;800&display=swap');
        </style>
      )
    }
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body
    class:list={{
      "locale-yue": lang === "yue-Hant",
      "locale-ja": lang === "ja",
    }}
  >
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  :global(*) {
    box-sizing: border-box;
  }

  body {
    font-family:
      Inter,
      ui-sans-serif,
      system-ui,
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    --brand: rgb(19, 51, 52);
    --brand-soft: rgb(32, 78, 80);
    --brand-muted: rgb(73, 113, 113);
    --brand-pale: rgb(220, 233, 231);
    --ink: rgb(19, 51, 52);
    --paper: rgb(247, 244, 236);
    --paper-warm: rgb(255, 250, 241);
    --accent: rgb(225, 169, 94);
    color: var(--ink);
    background: var(--paper);
  }

  body.locale-yue {
    font-family: "I.Ming", "I.MingCP", "I.MingVar", "I.MingVarCP", serif;
  }

  body.locale-ja {
    font-family: "Kaisei Tokumin", serif;
  }

  :global(a) {
    color: inherit;
  }
</style>
