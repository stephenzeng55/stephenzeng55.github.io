---
import heroImage from "../assets/portfolio-hero.png";
import hongKongFlag from "../assets/flags/hk.svg";
import japanFlag from "../assets/flags/jp.svg";
import unitedStatesFlag from "../assets/flags/us.svg";
import zengLogo from "../assets/zeng.webp";
import {
  locales,
  portfolioContent,
  type Locale,
  type PortfolioContent,
} from "../i18n/portfolio";

type Props = {
  content: PortfolioContent;
  locale: Locale;
};

const { content, locale } = Astro.props;
const localeFlags: Record<Locale, string> = {
  en: unitedStatesFlag.src,
  yue: hongKongFlag.src,
  ja: japanFlag.src,
};
const introNames: Record<Locale, string> = {
  en: "Stephen Zeng",
  yue: "曾家明",
  ja: "スティーブン・ゼン",
};
const localeLinks = locales.map((localeCode) => ({
  code: localeCode,
  content: portfolioContent[localeCode],
  flag: localeFlags[localeCode],
}));
const currentLocaleFlag = localeFlags[locale];
const introName = introNames[locale];
const introTitleRest = content.hero.title.startsWith(introName)
  ? content.hero.title.slice(introName.length).trimStart()
  : content.hero.title;
const introNameParticle =
  locale === "ja" && introTitleRest.startsWith("は") ? "は" : "";
const displayIntroTitleRest = introNameParticle
  ? introTitleRest.slice(introNameParticle.length).trimStart()
  : introTitleRest;
const introTitleSegments =
  locale === "en"
    ? ["builds", "cloud-ready", "software systems"]
    : locale === "yue"
      ? ["建構", "雲端就緒嘅", "軟件系統"]
    : locale === "ja"
      ? ["クラウド対応の", "ソフトウェアシステムを", "構築します"]
      : [displayIntroTitleRest];
---

<section class="hero" aria-labelledby="intro-title">
  <img class="hero__image" src={heroImage.src} alt="" fetchpriority="high" />
  <div class="hero__shade"></div>
  <header class="site-header" aria-label={content.nav.ariaLabel}>
    <div class="brand" aria-label={content.nav.homeLabel}>
      <img src={zengLogo.src} alt="" />
    </div>
    <div class="header-links">
      <nav>
        <a href="#work">{content.nav.work}</a>
        <a href="#about">{content.nav.about}</a>
        <a href="#contact">{content.nav.contact}</a>
      </nav>
      <details class="locale-switcher">
        <summary
          aria-label={`Change language, current language ${content.label}`}
        >
          <img
            class="locale-switcher__flag"
            src={currentLocaleFlag}
            alt=""
            width="24"
            height="24"
          />
        </summary>
        <div class="locale-switcher__menu" aria-label="Language selection">
          {
            localeLinks.map(({ code, content: localeContent, flag }) => (
              <a
                href={localeContent.path}
                lang={localeContent.lang}
                aria-current={code === locale ? "page" : undefined}
              >
                <img
                  class="locale-switcher__flag"
                  src={flag}
                  alt=""
                  width="24"
                  height="24"
                />
                {localeContent.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </header>

  <div class="hero__content">
    <h1 id="intro-title" aria-label={content.hero.title}>
      <span class="intro-title__name" aria-hidden="true">
        {introName}
        {introNameParticle && (
          <span class="intro-title__particle">{introNameParticle}</span>
        )}
      </span>
      <span
        class:list={[
          "intro-title__rest",
          {
            "intro-title__rest--english": locale === "en",
            "intro-title__rest--yue": locale === "yue",
            "intro-title__rest--phrased": locale === "ja",
          },
        ]}
        aria-hidden="true"
      >
        {
          introTitleSegments.map((segment) => (
            <span class="intro-title__line">{segment}</span>
          ))
        }
      </span>
    </h1>
    <p class="lede">{content.hero.lede}</p>
    <div class="hero__actions" aria-label={content.hero.actionsLabel}>
      <a class="button button--primary" href="#work">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M5 12h14M13 6l6 6-6 6"></path>
        </svg>
        {content.hero.viewWork}
      </a>
      <a class="button" href="mailto:stephenjzeng@gmail.com">
        <svg aria-hidden="true" viewBox="0 0 24 24">
          <path d="M4 6h16v12H4z"></path>
          <path d="m4 7 8 6 8-6"></path>
        </svg>
        {content.hero.getInTouch}
      </a>
    </div>
  </div>
</section>
