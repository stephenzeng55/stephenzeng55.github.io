  <p class="eyebrow">{contact.eyebrow}</p>
  <h2 id="contact-title">{contact.title}</h2>
  <div class="contact__links">
    <a href="mailto:stephenjzeng@gmail.com">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M4 6h16v12H4z"></path>
        <path d="m4 7 8 6 8-6"></path>
      </svg>
      {contact.email}
    </a>
    <a href="https://github.com/stephenzeng55">
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path
          d="M12 2C6.48 2 2 6.58 2 12.24c0 4.52 2.86 8.35 6.84 9.7.5.1.68-.22.68-.49v-1.9c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.56 2.35 1.11 2.92.85.09-.67.35-1.11.63-1.37-2.22-.26-4.55-1.14-4.55-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.27 2.75 1.05A9.35 9.35 0 0 1 12 6.93c.85 0 1.7.12 2.5.35 1.9-1.32 2.74-1.05 2.74-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.93-2.34 4.79-4.57 5.05.36.32.68.94.68 1.9v2.81c0 .27.18.59.69.49A10.14 10.14 0 0 0 22 12.24C22 6.58 17.52 2 12 2z"
