---
import HomePage from "../../components/HomePage.astro";
import { locales, portfolioContent, type Locale } from "../../i18n/portfolio";
import Layout from "../../layouts/Layout.astro";

export function getStaticPaths() {
  return locales
    .filter((locale) => locale !== "en")
    .map((locale) => ({ params: { locale } }));
}

const locale = Astro.params.locale as Locale;
const content = portfolioContent[locale];
---

<Layout lang={content.lang} title={content.title} description={content.description}>
  <HomePage content={content} locale={locale} />
</Layout>

